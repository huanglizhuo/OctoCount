{
  "_comment": "Copy to manifest.json for a real run. Every field must be filled per sample; failures stay in the manifest with outcome=failed and are never silently dropped.",
  "study": "filtering-effects",
  "engineVersionNote": "record report.tokeiVersion per run",
  "samples": [
    {
      "repository": "owner/repo",
      "repoUrl": "https://github.com/owner/repo",
      "pinnedCommit": "<sha resolved by the default run>",
      "collectedAt": "<ISO timestamp>",
      "runs": [
        {
          "config": "default",
          "options": { "ignoredDirs": [], "ignoredLanguages": [], "profile": "default", "includeDocs": true, "includeTests": true, "includeGenerated": true },
          "outcome": "ok",
          "kind": "cached|job",
          "wallTimeMs": 0,
          "tokeiVersion": "",
          "totals": { "files": 0, "lines": 0, "code": 0, "comments": 0, "blanks": 0 },
          "reportUrl": "https://octocounts.com/github/owner/repo/commit/<sha>"
        }
      ]
    }
  ]
}
